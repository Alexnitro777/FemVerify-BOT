{
  "token": "",    // токен бота (Discord Developer Portal → Bot → Token)
  "clientId": "", // id бота (Application ID)
  "guildId": "",  // id сервера (Server ID)

  "roles": {
    "verified": "",  // роль верифицированного участника
    "blacklist": "", // роль чёрного списка (ЧС)
    "admin": ["", ""], // роли админов (видят все команды бота)
    "mod": ["", ""],   // роли модераторов (видят /тег /анкеты /амнистии)
    "roleTag": ""      // роль за тег сервера (необязательно)
  },

  "channels": {
    "review": "",       // канал рассмотрения анкет
    "appealReview": "", // канал рассмотрения апелляций
    "welcome": "",      // канал приветствий (необязательно)
    "decisions": "",    // канал логов рассмотрения (необязательно)
    "appeal": "",       // канал подачи апелляций (необязательно)
    "tagLog": ""        // канал логов роли за тег (необязательно)
  },

  "questionCategoryId": "" // категория для каналов-вопросов
}
